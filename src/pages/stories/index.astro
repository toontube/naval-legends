---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import SEOHead from '../../components/SEOHead.astro';
import { getCollection } from 'astro:content';
import { tagLabel } from '../../lib/tagLabel';

const stories = await getCollection('stories');
const sorted = stories.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// Filter chips: tags shared by at least 3 stories, most common first
const tagCounts = new Map<string, number>();
for (const s of sorted) for (const t of s.data.tags) tagCounts.set(t, (tagCounts.get(t) || 0) + 1);
const filterTags = [...tagCounts.entries()]
  .filter(([, n]) => n >= 3)
  .sort((a, b) => b[1] - a[1])
  .map(([t]) => t);
---

<BaseLayout>
  <SEOHead
    slot="head"
    title="Stories | Bravo Zulu"
    description="In-depth articles on naval history. Commerce raiders, nuclear tests, unknown soldiers, and the warships that shaped the world."
  />

  <Navigation active="stories" showThemeToggle />

  <main id="main" class="stories-page">
    <h1 class="stories-title">Stories</h1>

    {filterTags.length > 0 && (
      <div class="story-filters" role="group" aria-label="Filter stories by topic">
        <button type="button" class="story-filter" data-tag="" aria-pressed="true">All</button>
        {filterTags.map((tag) => (
          <button type="button" class="story-filter" data-tag={tag} aria-pressed="false">{tagLabel(tag)}</button>
        ))}
      </div>
    )}

    <div class="stories-grid">
      {sorted.map((story) => (
        <a href={`/stories/${story.data.slug}/`} class="story-card" data-tags={story.data.tags.join(' ')}>
          {story.data.image && (
            <img src={story.data.image} alt={story.data.title} class="story-card-img" loading="lazy" decoding="async" />
          )}
          <div class="story-card-inner">
            <div class="story-meta">
              <time datetime={story.data.date.toISOString().split('T')[0]}>
                {story.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
              <span class="story-reading-time">{story.data.readingTime} min read</span>
            </div>
            <h2 class="story-card-title">{story.data.title}</h2>
            <p class="story-card-summary">{story.data.summary}</p>
            <div class="story-tags">
              {story.data.tags.map((tag: string) => (
                <span class="story-tag">{tagLabel(tag)}</span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </main>

  <script is:inline>
    (function () {
      var buttons = document.querySelectorAll('.story-filter');
      var cards = document.querySelectorAll('.story-card');
      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var tag = btn.dataset.tag;
          buttons.forEach(function (b) { b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'); });
          cards.forEach(function (card) {
            card.hidden = !!tag && card.dataset.tags.split(' ').indexOf(tag) === -1;
          });
          var gtag = window.gtag || function () {};
          gtag('event', 'filter_stories', { tag: tag || 'all' });
        });
      });
      var fromHash = decodeURIComponent(location.hash.slice(1));
      buttons.forEach(function (b) { if (fromHash && b.dataset.tag === fromHash) b.click(); });
    })();
  </script>

  <Footer />
</BaseLayout>

<style>
  .stories-page {
    padding-top: calc(var(--nav-height) + var(--banner-offset) + 2rem);
    padding-bottom: 2rem;
    max-width: 900px;
    margin: 0 auto;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }

  .stories-title {
    font-size: 2rem;
    margin-bottom: 2rem;
  }

  .stories-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .stories-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .story-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: -0.75rem 0 1.75rem;
  }

  .story-filter {
    font: inherit;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    cursor: pointer;
  }

  .story-filter[aria-pressed='true'] {
    color: var(--text-primary);
    border-color: var(--text-secondary);
    background: var(--bg-surface);
  }

  .story-filter:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 2px;
  }

  .story-card {
    display: block;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    transition: border-color 0.2s, transform 0.2s;
  }

  .story-card[hidden] {
    display: none;
  }

  .story-card-img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--bg-surface);
  }

  .story-card-inner {
    padding: 1.5rem;
  }

  .story-card:hover {
    border-color: var(--text-muted);
    transform: translateY(-2px);
  }

  .story-meta {
    display: flex;
    gap: 1rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .story-reading-time::before {
    content: '·';
    margin-right: 1rem;
  }

  .story-card-title {
    font-size: 1.25rem;
    line-height: 1.3;
    margin-bottom: 0.5rem;
  }

  .story-card-summary {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .story-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .story-tag {
    font-size: 0.75rem;
    color: var(--text-secondary);
    background: var(--bg-surface);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }
</style>
