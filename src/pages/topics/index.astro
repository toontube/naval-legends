---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/home.css';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import SEOHead from '../../components/SEOHead.astro';
import { TOPICS } from '../../lib/topics';
---

<BaseLayout>
  <SEOHead
    slot="head"
    title="Naval History Topics: Wars, Navies, Disasters | Bravo Zulu"
    description="Browse Bravo Zulu naval history stories by war, by navy and by theme: WWI, WWII, the Cold War, the Royal Navy, the US Navy, lost ships and the worst disasters."
  />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Naval History Topics",
    "url": "https://brvzulu.com/topics/",
    "publisher": { "@id": "https://brvzulu.com/#org" },
    "hasPart": TOPICS.map((t) => ({ "@type": "CollectionPage", "name": t.title, "url": `https://brvzulu.com/topics/${t.slug}/` })),
  })} />

  <Navigation active="stories" showThemeToggle />

  <main id="main" class="stories-page">
    <h1 class="stories-title">Naval history by topic</h1>
    {TOPICS.map((t) => (
      <section class="home-section">
        <h2 class="home-h2"><a href={`/topics/${t.slug}/`}>{t.name}</a></h2>
        <p class="home-lede">{t.intro}</p>
        <a href={`/topics/${t.slug}/`} class="home-more">{t.stories.length} stories &rarr;</a>
      </section>
    ))}
  </main>

  <Footer />
</BaseLayout>
