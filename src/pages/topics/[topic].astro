---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ORG } from '../../lib/seo';
import '../../styles/home.css';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import SEOHead from '../../components/SEOHead.astro';
import StoryCard from '../../components/StoryCard.astro';
import { getCollection } from 'astro:content';
import { TOPICS, type Topic } from '../../lib/topics';

export function getStaticPaths() {
  return TOPICS.map((topic) => ({ params: { topic: topic.slug }, props: { topic } }));
}

const { topic } = Astro.props as { topic: Topic };
const bySlug = new Map((await getCollection('stories')).map((s) => [s.data.slug, s.data]));
const stories = topic.stories.map((slug) => {
  const s = bySlug.get(slug);
  if (!s) throw new Error(`Topic ${topic.slug} lists unknown story ${slug}`);
  return s;
});
const url = `https://brvzulu.com/topics/${topic.slug}/`;

// Long-form overview for the hub, if written: src/content/topic-overviews/<slug>.md
const overviews = import.meta.glob<{ Content: any }>('../../content/topic-overviews/*.md', { eager: true });
const Overview = overviews[`../../content/topic-overviews/${topic.slug}.md`]?.Content;
const others = TOPICS.filter((t) => t.slug !== topic.slug);
---

<BaseLayout>
  <SEOHead slot="head" title={`${topic.title} | Bravo Zulu`} description={topic.intro.slice(0, 155).replace(/\s+\S*$/, '') + '.'} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": topic.title,
    "url": url,
    "description": topic.intro,
    "publisher": ORG,
    "mainEntity": {
      "@type": "ItemList",
      "itemListElement": stories.map((s, i) => ({
        "@type": "ListItem", "position": i + 1, "name": s.title, "url": `https://brvzulu.com/stories/${s.slug}/`,
      })),
    },
  })} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://brvzulu.com/" },
      { "@type": "ListItem", "position": 2, "name": "Topics", "item": "https://brvzulu.com/topics/" },
      { "@type": "ListItem", "position": 3, "name": topic.name, "item": url },
    ],
  })} />

  <Navigation active="stories" showThemeToggle />

  <main id="main" class="stories-page">
    <a href="/topics/" class="article-back">&larr; All topics</a>
    <h1 class="stories-title">{topic.title}</h1>
    <p class="home-lede">{topic.intro}</p>

    {Overview && (
      <div class="prose topic-overview">
        <Overview />
      </div>
    )}

    <h2 class="home-h2">All {topic.name} stories</h2>

    <div class="home-grid home-grid--3">
      {stories.map((s) => (
        <StoryCard slug={s.slug} title={s.title} summary={s.summary} image={s.image} readingTime={s.readingTime} />
      ))}
    </div>

    <h2 class="home-h2">More topics</h2>
    <div class="home-chips">
      {others.map((t) => <a href={`/topics/${t.slug}/`} class="home-chip">{t.name} <span class="home-chip-n">{t.stories.length}</span></a>)}
    </div>
  </main>

  <Footer />
</BaseLayout>
