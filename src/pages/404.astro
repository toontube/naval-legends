---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
---

<BaseLayout>
  <SEOHead
    slot="head"
    title="Page Not Found | Bravo Zulu"
    description="This page sank without a trace. Find the story you were looking for in the Bravo Zulu archive."
  />
  <meta slot="head" name="robots" content="noindex" />

  <Navigation showThemeToggle />

  <main id="main" class="about-page">
    <h1>This page sank without a trace</h1>
    <p>
      The link is wrong or the page has moved. Every story we have published is in the
      <a href="/stories/">story archive</a>, or start with today's card on the <a href="/">Daily feed</a>.
    </p>
  </main>

  <Footer />
</BaseLayout>

<style>
  .about-page {
    padding-top: calc(var(--nav-height) + var(--banner-offset) + 3rem);
    padding-bottom: 3rem;
    max-width: 600px;
    margin: 0 auto;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }

  .about-page h1 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
  }

  .about-page h2 {
    font-size: 1.375rem;
    margin: 2.25rem 0 0.75rem;
  }

  .about-page p {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
  }

  .about-page a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .about-social {
    display: flex;
    gap: 1.5rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .about-social a {
    font-size: 0.9375rem;
    text-decoration: none;
    color: var(--text-muted);
    transition: color 0.2s;
  }

  .about-social a:hover {
    color: var(--text-primary);
  }
</style>
