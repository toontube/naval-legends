---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';
import { TOPICS } from '../lib/topics';
import Navigation from '../components/Navigation.astro';
import SEOHead from '../components/SEOHead.astro';
import DailyCard from '../components/DailyCard';
import StoryCard from '../components/StoryCard.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const dailyCards = await getCollection('daily');
const sorted = dailyCards
  .map((c) => c.data)
  .sort((a, b) => a.order - b.order);

const stories = (await getCollection('stories'))
  .map((s) => s.data)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
const bySlug = new Map(stories.map((s) => [s.slug, s]));

// "Start here": the most retold stories, ranked by Jev's barbecue score
// (scripts/jev/score-candidates.py, 2026-10-13), top scorers that have a photo.
// Re-rank when stories change.
const START_HERE = ['den-helder-cavalry-fleet', 'hms-campbeltown-st-nazaire', 'uss-new-orleans-coconut-bow'];
const startHere = START_HERE.map((slug) => bySlug.get(slug)).filter((s) => s !== undefined);
const latest = stories.filter((s) => !START_HERE.includes(s.slug)).slice(0, 6);


// Ships we have written about, A to Z, each linking to its story
const ships = [...new Map(
  sorted
    .filter((c) => c.ship !== 'Various' && c.linkedStory !== 'placeholder' && bySlug.has(c.linkedStory))
    .map((c) => [c.ship, c.linkedStory] as const)
).entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<BaseLayout class="home">
  <SEOHead
    slot="head"
    title="Bravo Zulu | Daily Naval History"
    description="One naval history fact per day. Tap to learn. Share to brag. Come back tomorrow for the next one."
  />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Bravo Zulu",
    "url": "https://brvzulu.com",
    "description": "Daily naval history stories and in-depth articles about the world's warships. Each story starts with a surprising fact.",
    "publisher": {
      "@type": "Organization",
      "@id": "https://brvzulu.com/#org",
      "name": "Bravo Zulu",
      "url": "https://brvzulu.com/",
      "parentOrganization": { "@type": "Organization", "name": "MOZUMA", "url": "https://mozuma.co" }
    }
  })} />

  <Navigation active="daily" />

  <main id="main" class="home-main">
    <h1 class="sr-only">Bravo Zulu: one true naval history story every day</h1>
    <DailyCard client:idle cards={sorted} />

    <div class="home-sections">
      <section class="home-section" aria-labelledby="start-here">
        <h2 id="start-here" class="home-h2">New here? Start with these</h2>
        <p class="home-lede">The three stories readers retell most.</p>
        <div class="home-grid home-grid--3">
          {startHere.map((s) => (
            <StoryCard slug={s.slug} title={s.title} summary={s.summary} image={s.image} readingTime={s.readingTime} />
          ))}
        </div>
      </section>

      <section class="home-section" aria-labelledby="latest">
        <div class="home-head">
          <h2 id="latest" class="home-h2">Latest stories</h2>
          <a href="/stories/" class="home-more">All {stories.length} stories &rarr;</a>
        </div>
        <div class="home-grid home-grid--3">
          {latest.map((s) => (
            <StoryCard slug={s.slug} title={s.title} summary={s.summary} image={s.image} readingTime={s.readingTime} />
          ))}
        </div>
      </section>

      <section class="home-section" aria-labelledby="topics">
        <h2 id="topics" class="home-h2">Pick a war, a navy, a sea</h2>
        <div class="home-chips">
          {TOPICS.map((t) => (
            <a href={`/topics/${t.slug}/`} class="home-chip">{t.name} <span class="home-chip-n">{t.stories.length}</span></a>
          ))}
        </div>
      </section>

      <section class="home-section" aria-labelledby="ships">
        <h2 id="ships" class="home-h2">Looking for a ship?</h2>
        <p class="home-lede">Every ship we have written about so far. Did someone in your family serve on one? <a href="/submit/">Tell us their story</a>.</p>
        <ul class="home-ships">
          {ships.map(([name, slug]) => (
            <li><a href={`/stories/${slug}/`}>{name}</a></li>
          ))}
        </ul>
      </section>

      <section class="home-section home-ks" aria-labelledby="texas">
        <img src="/images/come-on-texas-book.png" alt="Come On, Texas graphic novel cover" class="home-ks-img" loading="lazy" width="500" height="499" />
        <div>
          <span class="home-ks-label">On Kickstarter Oct 27</span>
          <h2 id="texas" class="home-h2">Come On, Texas</h2>
          <p class="home-lede">The battleship that fought in both World Wars, from Veracruz to Normandy to Okinawa. A graphic novel about USS Texas and her crew.</p>
          <a href="https://www.kickstarter.com/projects/mozuma/come-on-texas?ref=bz-home" target="_blank" rel="noopener" class="home-ks-btn">Get notified at launch</a>
        </div>
      </section>
    </div>
  </main>
  <div id="subscribe"><Footer /></div>
</BaseLayout>
