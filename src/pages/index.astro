---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import SEOHead from '../components/SEOHead.astro';
import DailyCard from '../components/DailyCard';
import StoryCard from '../components/StoryCard.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { tagLabel } from '../lib/tagLabel';

const dailyCards = await getCollection('daily');
const sorted = dailyCards
  .map((c) => c.data)
  .sort((a, b) => a.order - b.order);

const stories = (await getCollection('stories'))
  .map((s) => s.data)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
const bySlug = new Map(stories.map((s) => [s.slug, s]));

// "Start here": the most retold stories, ranked by Jev's barbecue score
// (scripts/jev/score-candidates.py, 2026-10-13), top scorers that have a photo.
// Re-rank when stories change.
const START_HERE = ['den-helder-cavalry-fleet', 'hms-campbeltown-st-nazaire', 'uss-new-orleans-coconut-bow'];
const startHere = START_HERE.map((slug) => bySlug.get(slug)).filter((s) => s !== undefined);
const latest = stories.filter((s) => !START_HERE.includes(s.slug)).slice(0, 6);

// Topics shared by at least 3 stories, most common first
const tagCounts = new Map<string, number>();
for (const s of stories) for (const t of s.tags) tagCounts.set(t, (tagCounts.get(t) || 0) + 1);
const topics = [...tagCounts.entries()].filter(([, n]) => n >= 3).sort((a, b) => b[1] - a[1]).slice(0, 10);

// Ships we have written about, A to Z, each linking to its story
const ships = [...new Map(
  sorted
    .filter((c) => c.ship !== 'Various' && c.linkedStory !== 'placeholder' && bySlug.has(c.linkedStory))
    .map((c) => [c.ship, c.linkedStory] as const)
).entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<BaseLayout class="home">
  <SEOHead
    slot="head"
    title="Bravo Zulu | Daily Naval History"
    description="One naval history fact per day. Tap to learn. Share to brag. Come back tomorrow for the next one."
  />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Bravo Zulu",
    "url": "https://brvzulu.com",
    "description": "Daily naval history stories and in-depth articles about the world's warships. Each story starts with a surprising fact.",
    "publisher": {
      "@type": "Organization",
      "name": "Bravo Zulu",
      "url": "https://brvzulu.com"
    }
  })} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What happened to USS New Orleans in 1942?",
        "acceptedAnswer": { "@type": "Answer", "text": "USS New Orleans was hit by a torpedo at the Battle of Tassafaronga, blowing off 150 feet of bow and killing 182 sailors. The crew built a temporary bow from coconut logs at Tulagi and sailed backwards 1,800 miles to Sydney. The severed bow was found at 675 meters in 2025." }
      },
      {
        "@type": "Question",
        "name": "What was the Battle of Penang 1914?",
        "acceptedAnswer": { "@type": "Answer", "text": "SMS Emden entered Penang harbor with a fake fourth funnel, torpedoed the Russian cruiser Zhemchug, and killed 82 crew. The Russian captain was at the Eastern & Oriental Hotel. He was sentenced to 3.5 years." }
      },
      {
        "@type": "Question",
        "name": "Did Prinz Eugen survive nuclear bombs?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Prinz Eugen survived both atomic tests at Bikini Atoll in 1946 but became too radioactive to repair. She capsized from a small leak at Kwajalein. Her stern still sticks out of the water." }
      },
      {
        "@type": "Question",
        "name": "What does Bravo Zulu mean in the Navy?",
        "acceptedAnswer": { "@type": "Answer", "text": "Bravo Zulu (BZ) is the NATO signal flag code meaning 'well done.' It is the highest compliment one warship can signal to another." }
      }
    ]
  })} />

  <Navigation active="daily" />

  <main id="main" class="home-main">
    <h1 class="sr-only">Bravo Zulu: one true naval history story every day</h1>
    <DailyCard client:idle cards={sorted} />

    <div class="home-sections">
      <section class="home-section" aria-labelledby="start-here">
        <h2 id="start-here" class="home-h2">New here? Start with these</h2>
        <p class="home-lede">The three stories readers retell most.</p>
        <div class="home-grid home-grid--3">
          {startHere.map((s) => (
            <StoryCard slug={s.slug} title={s.title} summary={s.summary} image={s.image} readingTime={s.readingTime} />
          ))}
        </div>
      </section>

      <section class="home-section" aria-labelledby="latest">
        <div class="home-head">
          <h2 id="latest" class="home-h2">Latest stories</h2>
          <a href="/stories" class="home-more">All {stories.length} stories &rarr;</a>
        </div>
        <div class="home-grid home-grid--3">
          {latest.map((s) => (
            <StoryCard slug={s.slug} title={s.title} summary={s.summary} image={s.image} readingTime={s.readingTime} />
          ))}
        </div>
      </section>

      <section class="home-section" aria-labelledby="topics">
        <h2 id="topics" class="home-h2">Pick a war, a navy, a sea</h2>
        <div class="home-chips">
          {topics.map(([t, n]) => (
            <a href={`/stories#${t}`} class="home-chip">{tagLabel(t)} <span class="home-chip-n">{n}</span></a>
          ))}
        </div>
      </section>

      <section class="home-section" aria-labelledby="ships">
        <h2 id="ships" class="home-h2">Looking for a ship?</h2>
        <p class="home-lede">Every ship we have written about so far. Did someone in your family serve on one? <a href="/submit">Tell us their story</a>.</p>
        <ul class="home-ships">
          {ships.map(([name, slug]) => (
            <li><a href={`/stories/${slug}`}>{name}</a></li>
          ))}
        </ul>
      </section>

      <section class="home-section home-ks" aria-labelledby="texas">
        <img src="/images/come-on-texas-book.png" alt="Come On, Texas graphic novel cover" class="home-ks-img" loading="lazy" width="500" height="499" />
        <div>
          <span class="home-ks-label">On Kickstarter Oct 27</span>
          <h2 id="texas" class="home-h2">Come On, Texas</h2>
          <p class="home-lede">The battleship that fought in both World Wars, from Veracruz to Normandy to Okinawa. A graphic novel about USS Texas and her crew.</p>
          <a href="https://www.kickstarter.com/projects/mozuma/come-on-texas?ref=bz-home" target="_blank" rel="noopener" class="home-ks-btn">Get notified at launch</a>
        </div>
      </section>
    </div>
  </main>
  <div id="subscribe"><Footer /></div>
</BaseLayout>

<style is:global>
  body.home {
    overflow-y: auto;
  }

  .home-main {
    padding-top: calc(var(--nav-height) + var(--banner-offset));
  }

  .home-sections {
    max-width: 1000px;
    margin: 0 auto;
    padding: 1rem 1.25rem 3rem;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .home-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .home-h2 {
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.75rem);
    line-height: 1.2;
    margin-bottom: 0.5rem;
    text-wrap: balance;
  }

  .home-lede {
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    max-width: 60ch;
  }

  .home-lede a,
  .home-more {
    color: var(--accent);
  }

  .home-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .home-grid--3 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .home-grid--3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .home-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.75rem;
  }

  .home-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-primary);
    font-size: 0.9375rem;
  }

  .home-chip:hover {
    border-color: var(--text-secondary);
  }

  .home-chip-n {
    color: var(--text-muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }

  .home-ships {
    list-style: none;
    padding: 0;
    columns: 2 11rem;
    column-gap: 2rem;
  }

  .home-ships li {
    break-inside: avoid;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--border);
  }

  .home-ships a {
    color: var(--text-primary);
  }

  .home-ships a:hover {
    color: var(--accent);
  }

  .home-ks {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: center;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
  }

  @media (min-width: 640px) {
    .home-ks {
      grid-template-columns: 200px 1fr;
    }

    .home-ks-img {
      max-width: 200px;
    }
  }

  .home-ks-img {
    width: 100%;
    max-width: 140px;
    height: auto;
    border-radius: 6px;
  }

  .home-ks-label {
    display: inline-block;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .home-ks-btn {
    display: inline-block;
    padding: 0.7rem 1.25rem;
    border-radius: 8px;
    background: var(--accent);
    color: #fff;
    font-weight: 500;
  }


  /* Daily card container */
  .daily-container {
    max-width: 600px;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 3rem;
  }

  .daily-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .daily-day {
    font-family: var(--font-ui);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .daily-streak {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--accent);
    background: rgba(59, 130, 246, 0.1);
    padding: 0.2rem 0.625rem;
    border-radius: 100px;
  }

  /* Today's card */
  .daily-card-wrap {
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
  }

  .daily-card {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    min-height: 380px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #0c1929 0%, #1a1a2e 50%, #16213e 100%);
  }

  @media (min-width: 640px) {
    .daily-card {
      min-height: 440px;
    }
  }

  .daily-card-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
  }

  .daily-card-content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 2rem 1.5rem;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .daily-year {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    background: rgba(255, 255, 255, 0.08);
    padding: 0.2rem 0.625rem;
    border-radius: 100px;
  }

  .daily-hook {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 4vw, 1.75rem);
    font-weight: 700;
    line-height: 1.3;
    color: #fff;
    max-width: 95%;
  }

  .daily-ship {
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.5);
    font-weight: 500;
  }

  .daily-tap {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.3);
    margin-top: 0.5rem;
    animation: daily-pulse 2s ease-in-out infinite;
  }

  @keyframes daily-pulse {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 0.6; }
  }

  /* Revealed state */
  .daily-revealed {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .daily-reveal-text {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
  }

  .daily-actions {
    display: flex;
    gap: 0.5rem;
  }

  .daily-btn {
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 0.5rem 1.25rem;
    border-radius: 100px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .daily-btn:hover { opacity: 0.85; }

  .daily-btn--primary {
    color: #fff;
    background: var(--accent);
  }

  .daily-btn--share {
    color: rgba(255, 255, 255, 0.6);
    background: none;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .daily-btn--share:hover {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.3);
  }

  /* Stats */
  .daily-stats {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 1rem;
    padding: 0 0.25rem;
  }

  /* Archive */
  .daily-archive {
    margin-top: 2.5rem;
  }

  .daily-archive-title {
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .daily-archive-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .daily-archive-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem 1.25rem;
    cursor: pointer;
    transition: border-color 0.2s;
  }

  .daily-archive-card:hover {
    border-color: var(--text-muted);
  }

  .daily-archive-year {
    font-family: var(--font-ui);
    font-size: 0.6875rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .daily-archive-hook {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    line-height: 1.3;
    color: var(--text-primary);
    margin: 0.375rem 0;
  }

  .daily-archive-ship {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .daily-browse-all {
    display: block;
    text-align: center;
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    color: var(--accent);
    margin-top: 1.25rem;
    text-decoration: none;
  }

  .daily-browse-all:hover {
    text-decoration: underline;
  }
</style>
