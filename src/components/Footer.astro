const socials = [
  { label: 'Discord', href: 'https://discord.gg/cDzcW48dms', path: 'M20.3 4.4A19.6 19.6 0 0 0 15.4 3l-.6 1.3a18.2 18.2 0 0 0-5.6 0L8.6 3a19.6 19.6 0 0 0-4.9 1.4C.6 9 0 13.5.3 18a19.8 19.8 0 0 0 6 3l1.3-2.1a12.8 12.8 0 0 1-2-1l.5-.4a14.1 14.1 0 0 0 11.8 0l.5.4c-.6.4-1.3.7-2 1l1.3 2.1a19.7 19.7 0 0 0 6-3c.5-5.2-.8-9.7-3.4-13.6ZM8 15.3c-1.2 0-2.1-1.1-2.1-2.4S6.8 10.5 8 10.5s2.2 1.1 2.1 2.4c0 1.3-.9 2.4-2.1 2.4Zm8 0c-1.2 0-2.1-1.1-2.1-2.4s.9-2.4 2.1-2.4 2.2 1.1 2.1 2.4c0 1.3-.9 2.4-2.1 2.4Z' },
  { label: 'Facebook Page', href: 'https://www.facebook.com/brvzulu', path: 'M24 12a12 12 0 1 0-13.9 11.9v-8.4H7.1V12h3V9.4c0-3 1.8-4.7 4.5-4.7 1.3 0 2.7.2 2.7.2v3h-1.5c-1.5 0-2 .9-2 1.9V12h3.4l-.5 3.5h-2.9v8.4A12 12 0 0 0 24 12Z' },
  { label: 'Facebook Group', href: 'https://www.facebook.com/groups/bravozuluwardroom', path: 'M12 12.8a3.6 3.6 0 1 0 0-7.2 3.6 3.6 0 0 0 0 7.2Zm-6.4-.4a2.6 2.6 0 1 0 0-5.2 2.6 2.6 0 0 0 0 5.2Zm12.8 0a2.6 2.6 0 1 0 0-5.2 2.6 2.6 0 0 0 0 5.2ZM12 14.4c-3.3 0-6 1.9-6 4.2V20h12v-1.4c0-2.3-2.7-4.2-6-4.2Zm-7.6 4.2c0-1.4.6-2.6 1.6-3.6-.2 0-.3 0-.4 0-2.9 0-5.6 1.4-5.6 3.2V20h4.4v-1.4Zm15.2 0V20H24v-1.8c0-1.8-2.7-3.2-5.6-3.2h-.4c1 1 1.6 2.2 1.6 3.6Z' },
  { label: 'Instagram', href: 'https://instagram.com/mozumaa', path: 'M12 2.2c3.2 0 3.6 0 4.8.1 3.3.1 4.8 1.7 4.9 4.9.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 3.2-1.7 4.8-4.9 4.9-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-3.3-.1-4.8-1.7-4.9-4.9-.1-1.3-.1-1.6-.1-4.8s0-3.6.1-4.8C2.4 3.9 3.9 2.4 7.2 2.3c1.2-.1 1.6-.1 4.8-.1ZM12 0C8.7 0 8.3 0 7.1.1 2.7.3.3 2.7.1 7.1 0 8.3 0 8.7 0 12s0 3.7.1 4.9c.2 4.4 2.6 6.8 7 7 1.2.1 1.6.1 4.9.1s3.7 0 4.9-.1c4.4-.2 6.8-2.6 7-7 .1-1.2.1-1.6.1-4.9s0-3.7-.1-4.9c-.2-4.4-2.6-6.8-7-7C15.7 0 15.3 0 12 0Zm0 5.8a6.2 6.2 0 1 0 0 12.4 6.2 6.2 0 0 0 0-12.4ZM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.4-11.8a1.4 1.4 0 1 0 0 2.9 1.4 1.4 0 0 0 0-2.9Z' },
];
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-subscribe">
      <p class="footer-subscribe-text">New stories by email. No spam.</p>
      <form class="footer-subscribe-form" id="subscribe-form">
        <input
          type="email"
          name="email"
          placeholder="your@email.com"
          required
          class="footer-subscribe-input"
          id="subscribe-email"
        />
        <button type="submit" class="footer-subscribe-btn" id="subscribe-btn">Subscribe</button>
      </form>
      <p class="footer-subscribe-status" id="subscribe-status"></p>
    </div>
    <ul class="footer-social" aria-label="Bravo Zulu on social media">
      {socials.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} title={s.label} class="footer-social-link">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d={s.path} /></svg>
          </a>
        </li>
      ))}
    </ul>
    <p class="footer-copy">&copy; {year} Bravo Zulu</p>
  </div>
</footer>

<script is:inline>
  var subForm = document.getElementById('subscribe-form');
  var subBtn = document.getElementById('subscribe-btn');
  var subStatus = document.getElementById('subscribe-status');
  var subEmail = document.getElementById('subscribe-email');

  subForm.addEventListener('submit', function(e) {
    e.preventDefault();
    var email = subEmail.value;
    subBtn.disabled = true;
    subBtn.textContent = '...';

    var gtag = window.gtag || function(){};
    gtag('event', 'subscribe', { email_domain: email.split('@')[1], location: 'footer' });

    fetch('/api/subscribe', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: email, source: 'footer' })
    }).then(function(r) {
      if (r.ok) {
        localStorage.setItem('bz-subscribed', email);
        subForm.style.display = 'none';
        subStatus.textContent = 'You\'re in. New stories straight to your inbox.';
        subStatus.style.color = '#22c55e';
      } else {
        throw new Error();
      }
    }).catch(function() {
      subStatus.textContent = 'Something went wrong. Try again.';
      subStatus.style.color = '#ef4444';
      subBtn.disabled = false;
      subBtn.textContent = 'Subscribe';
    });
  });

  // If already subscribed, show thank you
  if (localStorage.getItem('bz-subscribed')) {
    subForm.style.display = 'none';
    subStatus.textContent = 'You\'re subscribed.';
    subStatus.style.color = 'var(--text-muted)';
  }
</script>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 2.5rem 1.25rem 2rem;
    text-align: center;
  }

  .footer-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .footer-subscribe {
    margin-bottom: 1.5rem;
  }

  .footer-subscribe-text {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
  }

  .footer-subscribe-form {
    display: flex;
    gap: 0.5rem;
    max-width: 360px;
    margin: 0 auto;
  }

  .footer-subscribe-input {
    flex: 1;
    font-family: var(--font-ui);
    font-size: 0.875rem;
    color: var(--text-primary);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.625rem 0.875rem;
    min-width: 0;
  }

  .footer-subscribe-input::placeholder {
    color: var(--text-muted);
  }

  .footer-subscribe-input:focus {
    outline: none;
    border-color: var(--accent);
  }

  .footer-subscribe-btn {
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    font-weight: 500;
    color: #fff;
    background: var(--accent);
    border: none;
    border-radius: 6px;
    padding: 0.625rem 1rem;
    white-space: nowrap;
    transition: opacity 0.2s;
  }

  .footer-subscribe-btn:hover {
    opacity: 0.9;
  }

  .footer-subscribe-btn:disabled {
    opacity: 0.5;
  }

  .footer-subscribe-status {
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    margin-top: 0.5rem;
    min-height: 1.25rem;
  }

  .footer-social {
    list-style: none;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin: 0 0 1.25rem;
    padding: 0;
  }

  .footer-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 6px;
    color: var(--text-muted);
    transition: color 0.2s;
  }

  .footer-social-link:hover,
  .footer-social-link:focus-visible {
    color: var(--accent);
  }

  .footer-copy {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
</style>
